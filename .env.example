# Variables pour `docker compose up` (orchestration complète, voir docker-compose.yml).
# Copier en .env à la racine du projet (pas dans coachboot-backend/ — ce fichier-là
# reste pour un démarrage sans Docker via `npm start`, voir coachboot-backend/.env.example).

# Obligatoire : signe les jetons JWT. Générer une vraie valeur aléatoire en
# production (ex. `openssl rand -hex 32`) — jamais la valeur d'exemple ci-dessous.
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire-en-production

# Mot de passe PostgreSQL (partagé par les services postgres + backend).
DB_PASSWORD=postgres

# Origine exacte autorisée à appeler l'API (le frontend). Le port 8080 est celui
# publié par le service "frontend" de docker-compose.yml — l'adapter si changé.
CORS_ORIGIN=http://localhost:8080

# Assistant IA — laisser vide pour désactiver proprement (503 documenté) plutôt
# que de faire échouer le démarrage.
ANTHROPIC_API_KEY=

# CoachBoot IA (entraînement de modèles) — sans intérêt tant que l'image backend
# n'a pas été étendue avec Python (voir coachboot-backend/Dockerfile).
PYTHON_BIN=
