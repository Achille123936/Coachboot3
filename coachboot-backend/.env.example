# Copier ce fichier en .env et adapter les valeurs à votre environnement.

# Base de données PostgreSQL — locale par défaut. Pour un fournisseur cloud
# (ex. Neon, RDS, Supabase) : renseigner l'hôte/utilisateur/mot de passe fournis
# et mettre DB_SSL=true (la plupart de ces fournisseurs exigent TLS).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coachboot
DB_SSL=false

# Sécurité
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire-en-production
NODE_ENV=development

# Serveur
PORT=4000

# CORS — origine autorisée à appeler l'API (le frontend). "*" en développement uniquement.
CORS_ORIGIN=*

# Assistant IA — fournisseur actif : 'anthropic' (Claude, par défaut) ou 'gemini'.
# Choix explicite uniquement — aucun repli automatique d'un fournisseur vers
# l'autre si la clé du fournisseur choisi est absente (échec clair en 503).
AI_PROVIDER=anthropic

# Assistant IA — clé API Anthropic (https://console.anthropic.com/settings/keys)
# Requise si AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Assistant IA — clé API Google Gemini (https://aistudio.google.com/apikey)
# Requise si AI_PROVIDER=gemini. GEMINI_MODEL est optionnel (défaut : gemini-2.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=

# CoachBoot IA — pipeline d'entraînement Python (voir ml/train.py, ml/predict.py,
# requirements dans ml/requirements.txt : pandas, numpy, scikit-learn, joblib).
# Laisser vide sur Windows (utilise le lanceur "py -3.12" par défaut). Sur
# Linux/macOS, mettre le binaire Python exact, ex: PYTHON_BIN=python3
PYTHON_BIN=
